    function cekKelulusan() {
      const nisn = document.getElementById("nisn").value;
      const hasil = document.getElementById("hasil");
      if(dataKelulusan[nisn]) {
        hasil.innerHTML = `<p><strong>${dataKelulusan[nisn].nama}</strong></p><p class="lulus">${dataKelulusan[nisn].keterangan}</p>`;
      } else {
        hasil.innerHTML = `<p class="tidak-lulus">Mohon maaf, data tidak ditemukan atau Anda belum lulus.</p>`;
      }
    }

    // Countdown
    const countDownDate = new Date("June 2, 2025 00:00:00").getTime();
    const countdownElement = document.getElementById("countdown");
    const x = setInterval(function() {
      const now = new Date().getTime();
      const distance = countDownDate - now;
      const days = Math.floor(distance / (1000 * 60 * 60 * 24));
      const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
      const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
      const seconds = Math.floor((distance % (1000 * 60)) / 1000);
      countdownElement.innerHTML = `Pengumuman dimulai dalam: ${days} hari ${hours} jam ${minutes} menit ${seconds} detik`;
      if (distance < 0) {
        clearInterval(x);
        countdownElement.innerHTML = "Pengumuman telah dibuka!";
      }
    }, 1000);
